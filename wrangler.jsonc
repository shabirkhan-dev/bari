// Static PWA served by Cloudflare Workers (static asset requests are free).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bari",
  "compatibility_date": "2026-10-10",
  "assets": {
    "directory": "./dist",
    // Unknown paths load the app (client-side routes, e.g. /join/ABCD2345).
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "bari.rabtx.dev", "custom_domain": true }]
}
